NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/myDB
MONGO_DB_NAME=myDB

# Firebase Admin credentials (use one method below)
# Method 0: service account JSON file path (relative to /server or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Method 1: complete service account JSON as one-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method 2: individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config (used by EJS /auth page)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# Optional auth-only override for Firebase authDomain (redirect handler domain)
FIREBASE_AUTH_ONLY_DOMAIN=

# Optional CORS allowlist (comma-separated). Leave empty for same-origin + localhost.
CORS_ORIGIN=http://localhost:5000

# Cloudinary (required for avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
